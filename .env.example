# Docker Compose variables: copy to .env (same folder as docker-compose.yml).
# Django-specific settings are in backend/.env (copy backend/.env.example).

# Database. Compose passes these to Postgres and to Django, so they exist in one place only.
POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=change-me

# Host ports. The database port is published on 127.0.0.1 only.
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# API address as the BROWSER sees it (the Vite dev server serves the page; the browser calls the API).
VITE_API_URL=http://localhost:8000/api/v1
