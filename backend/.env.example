# Django settings: copy to backend/.env.
# Docker Compose also injects POSTGRES_HOST/PORT/DB/USER/PASSWORD (from the root .env),
# so you do not set the database here when using Docker.

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# true for development only. When false, session/CSRF cookies are Secure (HTTPS required).
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed only behind HTTPS with a different public origin, e.g. https://lms.example.com
CSRF_TRUSTED_ORIGINS=
# Set to false only if you run a production-style stack over plain HTTP (testing, not for real use).
# SECURE_COOKIES=true

# Browser origins allowed to call the API (the frontend). Comma-separated, no trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# "Days overdue" are counted in this time zone (an IANA name, e.g. Asia/Tokyo, America/Sao_Paulo).
TIME_ZONE=UTC

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Optional: sign JWTs with a key other than DJANGO_SECRET_KEY.
# JWT_SIGNING_KEY=

# Rate limits (login/register/refresh use "auth", per IP)
THROTTLE_ANON=60/min
THROTTLE_USER=300/min
THROTTLE_AUTH=10/min

# Email. The console backend prints "reservation ready" emails to the backend log.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=library@example.com
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587

LOG_LEVEL=INFO

# Seconds a database connection is kept open between requests (0 = a new connection per request).
DB_CONN_MAX_AGE=60

# Only when running Django OUTSIDE Docker (Compose sets these for you):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=lms
# POSTGRES_USER=lms
# POSTGRES_PASSWORD=change-me
